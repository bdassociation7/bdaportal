-- ============================================================================
-- BDA Portal Email System - Database Schema
-- ============================================================================

-- Email Logs Table
-- Tracks all sent emails for debugging, analytics, and retry logic
CREATE TABLE IF NOT EXISTS email_logs (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

  -- Email details
  email_type TEXT NOT NULL,           -- e.g., 'membership_activated'
  recipient_email TEXT NOT NULL,
  recipient_user_id UUID REFERENCES auth.users(id),
  subject TEXT NOT NULL,

  -- Status tracking
  status TEXT NOT NULL DEFAULT 'pending',  -- pending, queued, sent, failed, bounced
  resend_id TEXT,                     -- Resend message ID
  error_message TEXT,

  -- Context data (for debugging/resending)
  template_data JSONB,

  -- Timestamps
  created_at TIMESTAMPTZ DEFAULT NOW(),
  sent_at TIMESTAMPTZ,

  -- Constraints
  CONSTRAINT valid_status CHECK (status IN ('pending', 'queued', 'sent', 'failed', 'bounced'))
);

-- Indexes for efficient queries
CREATE INDEX IF NOT EXISTS idx_email_logs_user ON email_logs(recipient_user_id);
CREATE INDEX IF NOT EXISTS idx_email_logs_type ON email_logs(email_type);
CREATE INDEX IF NOT EXISTS idx_email_logs_status ON email_logs(status);
CREATE INDEX IF NOT EXISTS idx_email_logs_created ON email_logs(created_at DESC);

-- Email Templates Table
-- Stores HTML templates with variables for each email type
CREATE TABLE IF NOT EXISTS email_templates (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),

  -- Template identification
  template_key TEXT UNIQUE NOT NULL,  -- e.g., 'membership_activated'
  name TEXT NOT NULL,                 -- Human readable name
  category TEXT NOT NULL,             -- Category (account, membership, exam, etc.)

  -- Template content
  subject TEXT NOT NULL,
  html_body TEXT NOT NULL,
  text_body TEXT,                     -- Plain text fallback

  -- Variables used in template (for documentation)
  variables JSONB,                    -- List of expected variables like ["user_name", "expiry_date"]

  -- Status
  is_active BOOLEAN DEFAULT true,

  -- Timestamps
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- RLS Policies
ALTER TABLE email_logs ENABLE ROW LEVEL SECURITY;
ALTER TABLE email_templates ENABLE ROW LEVEL SECURITY;

-- Email logs: Only service role can insert/update (via Edge Functions)
-- Users can view their own email logs
CREATE POLICY "Users can view their own email logs"
  ON email_logs FOR SELECT
  USING (auth.uid() = recipient_user_id);

CREATE POLICY "Service role can manage email logs"
  ON email_logs FOR ALL
  USING (auth.jwt() ->> 'role' = 'service_role');

-- Email templates: Read-only for authenticated users, full access for service role
CREATE POLICY "Authenticated users can view active templates"
  ON email_templates FOR SELECT
  USING (is_active = true);

CREATE POLICY "Service role can manage email templates"
  ON email_templates FOR ALL
  USING (auth.jwt() ->> 'role' = 'service_role');

-- Function to update updated_at timestamp
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger for email_templates
CREATE TRIGGER update_email_templates_updated_at
  BEFORE UPDATE ON email_templates
  FOR EACH ROW
  EXECUTE FUNCTION update_updated_at_column();
